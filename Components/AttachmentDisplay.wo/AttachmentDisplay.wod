IsPdf : WOConditional {
  condition = isPdf;
}

PdfLink : ERAttachmentLink {
  attachment = attachment;
}

IsWord : WOConditional {
  condition = isWord;
}

WordPreview : WOString {
  value = wordPreviewHtml;
  escapeHTML = false;
}

WordLink : ERAttachmentLink {
  attachment = attachment;
}


PdfImage : WOGenericElement {
  elementName = "img";
  src = pdfPreviewSrc;
  style = pdfImageStyle;
}

IsSpreadsheet : WOConditional {
  condition = isSpreadsheet;
}

SheetTable : WOString {
  value = spreadsheetPreviewHtml;
  escapeHTML = false;
}

SheetLink : ERAttachmentLink {
  attachment = attachment;
}

IsOther : WOConditional {
  condition = isOther;
}

Viewer : WOSwitchComponent {
  WOComponentName = "er.attachment.components.ERAttachmentViewer";
  attachment = attachment;
  width = 200;
}

IsImage : WOConditional {
  condition = isImage;
}

ImagePreview : WOGenericElement {
  elementName = "img";
  src = imageSrc;
  style = imageStyle;
}